# Public site URL (share cards, sitemap, OG)
NEXT_PUBLIC_APP_URL=http://localhost:3456

# Analytics: Plausible domain OR GA4 id (G-XXXXXXXX)
NEXT_PUBLIC_ANALYTICS_ID=

# Waitlist forms (Formspree form ids — https://formspree.io)
NEXT_PUBLIC_FORMSPREE_B2B=
NEXT_PUBLIC_FORMSPREE_PREMIUM=

# One-time report payment (Stripe Payment Link URL, optional)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Server-only: OpenAI for /api/simulate (falls back to mock)
OPENAI_API_KEY=

# Free simulations per IP per day (default 1)
RATE_LIMIT_FREE_PER_DAY=1

# Optional: Supabase for cloud saves
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
